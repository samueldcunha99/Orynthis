# Shopify — backend only. The storefront token is read server-side in
# lib/shopify.ts and is never shipped to the browser.
#
# Where to get the token:
#   Shopify admin -> Settings -> Apps and sales channels -> Develop apps
#   -> Create an app -> Configure Storefront API scopes
#   -> tick unauthenticated_read_product_listings and
#      unauthenticated_read_product_inventory
#   -> Install app -> copy the Storefront API access token
#
# Leave SHOPIFY_STOREFRONT_TOKEN unset and the site falls back to the
# hardcoded prices in lib/products.ts, exactly as it behaved before.
SHOPIFY_STORE_DOMAIN=orynthis.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# Pinned deliberately. Shopify supports a version for 12 months.
SHOPIFY_API_VERSION=2025-10

# Public origins. Identical until orynthis.com is repointed at Vercel; after
# the move NEXT_PUBLIC_SHOP_URL becomes the subdomain Shopify keeps, and it
# is what checkout, customer accounts and the policy pages link to.
NEXT_PUBLIC_SITE_URL=https://orynthis.com
NEXT_PUBLIC_SHOP_URL=https://orynthis.com
